{
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "repository",
        "digest"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "publicUrl": {
      "type": "string",
      "pattern": "^https://[^/?#@]+/?$"
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "sandboxNamespace": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "zones": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
          },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
            }
          }
        ]
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "authorityBucket": {
          "type": "string",
          "minLength": 3
        },
        "artifactBucket": {
          "type": "string",
          "minLength": 3
        },
        "archiveBucket": {
          "type": "string",
          "minLength": 3
        },
        "rapid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ackZones",
            "buckets"
          ],
          "properties": {
            "ackZones": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            "buckets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 7,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bucket",
                  "zone"
                ],
                "properties": {
                  "bucket": {
                    "type": "string",
                    "minLength": 3
                  },
                  "zone": {
                    "type": "string",
                    "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "authorityBucket",
        "artifactBucket",
        "archiveBucket",
        "rapid"
      ],
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "googleServiceAccount": {
          "type": "string",
          "pattern": "^[^@]+@[^@]+[.]iam[.]gserviceaccount[.]com$"
        }
      },
      "required": [
        "googleServiceAccount"
      ]
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "const": true
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "image",
    "replicaCount",
    "publicUrl",
    "region",
    "sandboxNamespace",
    "zones",
    "storage",
    "serviceAccount",
    "networkPolicy"
  ],
  "$schema": "https://json-schema.org/draft-07/schema#"
}
